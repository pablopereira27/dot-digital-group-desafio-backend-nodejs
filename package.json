{
  "name": "dot-digital-group-desafio-backend-nodejs",
  "version": "1.0.0",
  "description": "Desenvolver uma **REST API em Node.js** para gerenciamento de cursos, turmas e usuários.  \r O sistema deve permitir:\r - CRUD de cursos e turmas.  \r - CRUD de usuários.  \r - Matrícula de usuários em turmas disponíveis.  \r - Listagem de cursos e turmas com filtros.  \r - Aplicação de regras de negócio:  \r   - Não permitir matrícula em turmas encerradas ou fora da data.  \r   - Usuário não pode se matricular em mais de uma turma do mesmo curso.",
  "homepage": "https://github.com/pablopereira27/dot-digital-group-desafio-backend-nodejs#readme",
  "bugs": {
    "url": "https://github.com/pablopereira27/dot-digital-group-desafio-backend-nodejs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablopereira27/dot-digital-group-desafio-backend-nodejs.git"
  },
  "license": "ISC",
  "author": "Pablo Pereira",
  "type": "commonjs",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migration:create": "typeorm migration:create --outputJs",
    "migration:generate": "typeorm migration:generate --outputJs -d ./src/data-source.js",
    "migration:run": "typeorm migration:run -d ./src/data-source.js",
    "migration:revert": "typeorm migration:revert -d ./src/data-source.js",
    "test": "jest"
  },
  "dependencies": {
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.22.4",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^1.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2"
  }
}
